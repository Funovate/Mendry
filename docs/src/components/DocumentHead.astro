---
const route = Astro.locals.starlightRoute;
const { entry, head, lang, lastUpdated } = route;
const site = Astro.site;
const publicRelease = site !== undefined;
const is404 =
  entry.data.translationKey === "not-found" ||
  Astro.url.pathname === "/404" ||
  Astro.url.pathname === "/404/" ||
  Astro.url.pathname.endsWith("/404.html");
const indexable = !is404 && entry.data.availability !== "planned";
const robots = is404
  ? "noindex, nofollow"
  : publicRelease
    ? indexable
      ? "index, follow"
      : "noindex, follow"
    : "noindex, nofollow";

const entries = head.filter(
  ({ tag, attrs }) =>
    !(tag === "meta" && attrs?.name === "robots") &&
    !(tag === "meta" && attrs?.property === "og:type") &&
    !(
      is404 &&
      tag === "link" &&
      (attrs?.rel === "canonical" || attrs?.rel === "alternate")
    ),
);

const canonicalValue = is404
  ? undefined
  : entries.find(
      ({ tag, attrs }) => tag === "link" && attrs?.rel === "canonical",
    )?.attrs?.href;
const canonical =
  typeof canonicalValue === "string" ? canonicalValue : undefined;
const existingImageValue = entries.find(
  ({ tag, attrs }) => tag === "meta" && attrs?.property === "og:image",
)?.attrs?.content;
const existingImage =
  typeof existingImageValue === "string" ? existingImageValue : undefined;
const socialImage = site && !is404
  ? existingImage || new URL("/media/execution-model.png", site).href
  : undefined;
const title = entry.data.title;
const description = entry.data.description;
const isHomepage =
  Astro.url.pathname === "/" || Astro.url.pathname === "/zh-cn/";

function breadcrumbItems(publicSite: URL) {
  const isZh = lang === "zh-CN";
  const localePrefix = Astro.url.pathname.startsWith("/zh-cn/") ? "/zh-cn" : "";
  const currentPath = Astro.url.pathname;
  const items: Array<{
    "@type": string;
    position: number;
    name: string;
    item: string;
  }> = [
    {
      "@type": "ListItem",
      position: 1,
      name: isZh ? "首页" : "Home",
      item: new URL(`${localePrefix}/`, publicSite).href,
    },
  ];

  if (currentPath === `${localePrefix}/docs/`) {
    items.push({
      "@type": "ListItem",
      position: 2,
      name: isZh ? "文档概览" : "Documentation",
      item: new URL(`${localePrefix}/docs/`, publicSite).href,
    });
    return items;
  }

  items.push({
    "@type": "ListItem",
    position: 2,
    name: isZh ? "文档概览" : "Documentation",
    item: new URL(`${localePrefix}/docs/`, publicSite).href,
  });

  if (
    currentPath.startsWith(`${localePrefix}/docs/get-started/`) &&
    currentPath !== `${localePrefix}/docs/get-started/`
  ) {
    items.push({
      "@type": "ListItem",
      position: 3,
      name: isZh ? "入门" : "Get started",
      item: new URL(`${localePrefix}/docs/get-started/`, publicSite).href,
    });
  }

  items.push({
    "@type": "ListItem",
    position: items.length + 1,
    name: title,
    item: canonical || new URL(currentPath, publicSite).href,
  });

  return items;
}

function buildStructuredData() {
  if (!site || !indexable || !canonical || is404) return undefined;

  const organizationId = `${site.href}#organization`;
  const websiteId = `${site.href}#website`;
  const commonEntities = [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Mendry",
      url: site.href,
      sameAs: ["https://github.com/Funovate/Mendry"],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Mendry",
      url: site.href,
      inLanguage: ["en", "zh-CN"],
      publisher: { "@id": organizationId },
    },
  ];
  const graph = isHomepage
    ? [
        ...commonEntities,
        {
          "@type": "WebPage",
          "@id": `${canonical}#webpage`,
          name: title,
          description,
          url: canonical,
          inLanguage: lang,
          isPartOf: { "@id": websiteId },
        },
      ]
    : [
        ...commonEntities,
        {
          "@type": "TechArticle",
          "@id": `${canonical}#article`,
          headline: title,
          description,
          url: canonical,
          inLanguage: lang,
          ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
          author: { "@id": organizationId },
          publisher: { "@id": organizationId },
          isPartOf: { "@id": websiteId },
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical}#breadcrumb`,
          itemListElement: breadcrumbItems(site),
        },
      ];

  return JSON.stringify({
    "@context": "https://schema.org",
    "@graph": graph,
  }).replaceAll("<", "\\u003c");
}

const structuredData = buildStructuredData();
---

{
  entries.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
<meta name="robots" content={robots} />
<meta property="og:type" content={isHomepage ? "website" : "article"} />
{
  socialImage && (
    <>
      {!existingImage && <meta property="og:image" content={socialImage} />}
      <meta
        property="og:image:alt"
        content={
          lang === "zh-CN"
            ? "Mendry AI 生产问题调查执行模型"
            : "Mendry AI incident investigation execution model"
        }
      />
      <meta name="twitter:title" content={title} />
      {description && <meta name="twitter:description" content={description} />}
      <meta name="twitter:image" content={socialImage} />
    </>
  )
}
{
  structuredData && (
    <script type="application/ld+json" set:html={structuredData} is:inline />
  )
}
