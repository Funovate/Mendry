---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Introduction from "../../components/Introduction.astro";
import { introContent } from "../../content/intro";

const content = introContent["zh-CN"];
const publicOrigin = process.env.DOCS_PUBLIC_RELEASE === "true" && process.env.PUBLIC_SITE_ORIGIN;
---

<StarlightPage
  frontmatter={{
    title: content.title,
    description: content.description,
    template: "splash",
    pagefind: false,
    head: publicOrigin
      ? [
          {
            tag: "meta",
            attrs: {
              property: "og:image",
              content: new URL("/media/remediation-review.webp", publicOrigin).href,
            },
          },
        ]
      : [],
  }}
  hasSidebar={false}
>
  <Introduction content={content} />
</StarlightPage>
