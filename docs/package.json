{
  "name": "@fixthe/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "lint": "prettier --check .",
    "check": "node scripts/run-astro.mjs check && node scripts/check-routes.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build": "node scripts/run-astro.mjs build && node scripts/check-build.mjs && node scripts/check-release-build.mjs",
    "build:public": "node scripts/build-public.mjs",
    "check:release": "node scripts/check-release-build.mjs",
    "audit:production": "npm audit --omit=dev",
    "verify": "node scripts/verify.mjs",
    "preview": "node scripts/run-astro.mjs preview",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.2",
    "yaml": "^2.9.0"
  }
}
