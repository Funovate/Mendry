# MENDRY_* is the preferred configuration namespace. Every key has a
# FIXTHE_* compatibility fallback; when both exist, MENDRY_* wins, including
# an explicitly empty value.
# MENDRY_* 是首选配置命名空间。每个键都有对应的 FIXTHE_* 兼容回退；两者同时存在时，
# MENDRY_* 优先，包括显式设置为空字符串的情况。

# Runtime / 运行时

# Deployment environment name used by the service.
# 服务使用的部署环境名称。
MENDRY_ENVIRONMENT=development
# Minimum log level; accepted values are debug, info, warn, and error.
# 日志的最低级别；允许 debug、info、warn 或 error。
MENDRY_LOG_LEVEL=info
# Log output format; use console for development terminals and json for deployments.
# 日志输出格式；开发终端使用 console，部署环境使用 json。
MENDRY_LOG_FORMAT=console
# Optional local log file; when non-empty, terminal output is retained and logs are appended in the same format. Parent directories are created automatically.
# 可选的本地日志文件；非空时保留终端输出并以相同格式追加写入，父目录会自动创建。
MENDRY_LOG_FILE=./logs/mendry.log
# Time limit for each shutdown phase after the process receives a termination signal; accepted range is 1s to 2m.
# 进程收到退出信号后，各关闭阶段使用的时间上限；允许 1s 至 2m。
MENDRY_SHUTDOWN_TIMEOUT=15s

# HTTP / HTTP 服务

# API server listen address in host:port format; the default listens only on the local loopback interface.
# API 服务器的监听地址，格式为 host:port；默认只监听本机回环地址。
MENDRY_HTTP_ADDR=127.0.0.1:8080
# Maximum time to read HTTP request headers; accepted range is 100ms to 1m.
# 读取 HTTP 请求头的最长时间；允许 100ms 至 1m。
MENDRY_HTTP_READ_HEADER_TIMEOUT=5s
# Maximum time to read a complete HTTP request; accepted range is 100ms to 5m.
# 读取完整 HTTP 请求的最长时间；允许 100ms 至 5m。
MENDRY_HTTP_READ_TIMEOUT=15s
# Maximum time to write an HTTP response; accepted range is 100ms to 5m.
# 写出 HTTP 响应的最长时间；允许 100ms 至 5m。
MENDRY_HTTP_WRITE_TIMEOUT=30s
# Maximum idle time for a keep-alive connection while waiting for the next request; accepted range is 1s to 10m.
# keep-alive 连接等待下一个请求的最长空闲时间；允许 1s 至 10m。
MENDRY_HTTP_IDLE_TIMEOUT=60s
# Maximum size of a single HTTP request body in bytes; accepted range is 1024 to 10485760 (10 MiB).
# 单个 HTTP 请求体的字节上限；允许 1024 至 10485760（10 MiB）。
MENDRY_HTTP_MAX_BODY_BYTES=1048576
# Single origin allowed for browser cross-origin access. Leave empty for same-origin deployments. A non-empty value must be an HTTP/HTTPS origin without credentials, path, query, or fragment.
# 浏览器跨源访问允许的唯一来源；同源部署留空，非空值必须是无凭据、路径、查询和片段的 HTTP/HTTPS origin。
MENDRY_HTTP_CORS_ALLOWED_ORIGIN=
# When explicitly enabled, INFO http.request.completed logs include complete request/response bodies, queries, headers, and cookies, including plaintext secrets, and redacted http.request.failed logs are no longer written. Disabled by default. This is an unsafe debugging switch; do not leave it enabled with shared logs. MENDRY_LOG_LEVEL=debug does not enable it.
# 显式打开后，INFO http.request.completed 会带上完整的请求/响应体、查询、请求头和 Cookie（含密钥明文），且不再写脱敏的 http.request.failed。默认关闭；这是不安全的调试开关，不要在共享日志中长期开启。MENDRY_LOG_LEVEL=debug 不会打开它。
MENDRY_HTTP_REQUEST_DEBUG=false
# Public base URL exposed by the API and used to derive inbound webhook URLs. It must be an absolute HTTP/HTTPS URL without credentials, query, fragment, or trailing slash; a path prefix is allowed. The migrate, seed, and bootstrap-admin commands do not read it.
# API 对外展示的公共基址，用于派生 Webhook 入站 URL；必须是无凭据、查询、片段且无尾斜杠的绝对 HTTP/HTTPS URL，可带路径前缀。migrate、seed 和 bootstrap-admin 命令不读取。
MENDRY_PUBLIC_URL=http://127.0.0.1:8080

# Authentication / 认证

# Absolute lifetime of a Redis session; accepted range is 5m to 720h (30 days).
# Redis Session 的绝对有效期；允许 5m 至 720h（30 天）。
MENDRY_AUTH_SESSION_TTL=24h
# Maximum wait time for a webhook AI normalization call; accepted range is 100ms to 10m.
# Webhook AI 归一化调用的最长等待时间；允许 100ms 至 10m。
MENDRY_WEBHOOK_AI_TIMEOUT=60s
# Total time limit for one remediation model turn, including all HTTP retries and backoff; accepted range is 30s to 20m.
# 单个 remediation 模型轮次的总时限，包含所有 HTTP 重试与退避；允许 30s 至 20m。
MENDRY_REMEDIATION_MODEL_TIMEOUT=5m
# Scan unfinished runs immediately on startup and at this interval (1s to 5m).
# 启动立即扫描未完成任务，随后按此间隔重试扫描（1s 至 5m）。
MENDRY_REMEDIATION_RECOVERY_INTERVAL=15s
# Per-process execution limit shared by normal and recovered runs (1 to 32).
# Each active run holds one additional PostgreSQL session outside the query pool.
# 正常执行与恢复任务共享的单进程并发上限（1 至 32）；每个活跃任务额外占用一个查询池之外的 PostgreSQL 会话。
MENDRY_REMEDIATION_CONCURRENCY=4
# Optional persistent storage overrides. Without them, both roots default under the startup working directory at .var/remediation/.
# Configure both with separate absolute paths for production or container volume mounts.
# 可选持久化目录覆盖；未配置时默认使用启动工作目录下的 .var/remediation/。
# 生产环境或容器卷挂载应同时配置两个彼此分离的绝对路径。
# MENDRY_REMEDIATION_ARTIFACT_ROOT=/var/lib/mendry/remediation/artifacts
# MENDRY_REMEDIATION_WORKSPACE_ROOT=/var/lib/mendry/remediation/workspaces
# Transitional deployment inputs for Mendry's built-in Go 1.23 and Node 22 toolchain catalog.
# These are platform release settings, never project/user-provided validation images. Immutable digests only.
# Mendry 内置 Go 1.23/Node 22 工具链目录的过渡部署输入；仅平台发行配置，项目用户不可提供。只能使用不可变 digest。
# MENDRY_REMEDIATION_GO_BUILDER_IMAGE=registry.example/mendry/go@sha256:<64-lowercase-hex>
# MENDRY_REMEDIATION_NODE_BUILDER_IMAGE=registry.example/mendry/node@sha256:<64-lowercase-hex>
# Optional executable overrides and pinned SSH host keys; never accept host keys dynamically.
# 可选的可执行文件路径和固定 SSH 主机密钥；不得动态接受主机密钥。
# MENDRY_REMEDIATION_DOCKER_COMMAND=/usr/bin/docker
# MENDRY_REMEDIATION_GIT_COMMAND=/usr/bin/git
# MENDRY_REMEDIATION_SSH_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
# Initial administrator password read only by the bootstrap-admin command; it must be 12 to 72 bytes. Never commit a real value.
# 仅 bootstrap-admin 命令读取的首个管理员密码；至少 12 字节且最多 72 字节，不要提交真实值。
# MENDRY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Project credential encryption / 项目凭据加密

# Deployment-level AES-256 key required by the API. It must be exactly 32 random bytes encoded as standard base64; generate one with `openssl rand -base64 32`.
# API 必填的部署级 AES-256 密钥，必须是 32 随机字节的标准 base64；可用 `openssl rand -base64 32` 生成。
# Keep this value stable for a database and never commit a real value. Migration and bootstrap-admin do not read it.
# 同一数据库必须保持该值稳定且不得提交真实值；migration 和 bootstrap-admin 不读取。
MENDRY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# PostgreSQL

# Single-line pgx connection string required by the API and migration commands. It may contain credentials; never commit a real value or write it to logs.
# API 和 migration 命令必填的单行 pgx 连接串；可能包含凭据，不得提交真实值或写入日志。
MENDRY_POSTGRES_URL=postgres://mendry:replace-me@127.0.0.1:5432/mendry?sslmode=disable
# Maximum time to establish a PostgreSQL connection; accepted range is 100ms to 1m.
# 建立 PostgreSQL 连接的最长时间；允许 100ms 至 1m。
MENDRY_POSTGRES_CONNECT_TIMEOUT=5s
# Maximum time to acquire a connection from pgxpool; accepted range is 100ms to 1m.
# 从 pgxpool 获取连接的最长等待时间；允许 100ms 至 1m。
MENDRY_POSTGRES_ACQUIRE_TIMEOUT=2s
# Execution time limit for each PostgreSQL statement; accepted range is 100ms to 10m.
# 每条 PostgreSQL 语句的执行时间上限；允许 100ms 至 10m。
MENDRY_POSTGRES_STATEMENT_TIMEOUT=30s
# Per-attempt timeout for PostgreSQL startup and readiness probes; accepted range is 100ms to 30s.
# PostgreSQL 启动和就绪探针的单次超时；允许 100ms 至 30s。
MENDRY_POSTGRES_HEALTH_TIMEOUT=2s
# Minimum number of connections retained by pgxpool; accepted range is 0 to 100 and must not exceed the maximum.
# pgxpool 保持的最少连接数；允许 0 至 100，且不得大于最大连接数。
MENDRY_POSTGRES_MIN_CONNS=1
# Maximum number of connections allowed by pgxpool; accepted range is 1 to 100.
# pgxpool 允许的最多连接数；允许 1 至 100。
MENDRY_POSTGRES_MAX_CONNS=10
# Maximum lifetime of a reusable PostgreSQL connection; accepted range is 1m to 24h.
# 单个 PostgreSQL 连接可被复用的最长生命周期；允许 1m 至 24h。
MENDRY_POSTGRES_MAX_CONN_LIFETIME=30m
# Maximum time a PostgreSQL connection may remain idle in the pool; accepted range is 30s to 1h.
# PostgreSQL 连接在连接池中保持空闲的最长时间；允许 30s 至 1h。
MENDRY_POSTGRES_MAX_CONN_IDLE_TIME=5m
# Interval at which pgxpool proactively checks idle connection health; accepted range is 1s to 10m.
# pgxpool 主动检查空闲连接健康状态的周期；允许 1s 至 10m。
MENDRY_POSTGRES_HEALTH_CHECK_PERIOD=30s
# PostgreSQL queries at or above this duration are logged as slow queries; accepted range is 10ms to 1m. SQL parameters are not logged.
# PostgreSQL 查询达到该耗时后记录为慢查询；允许 10ms 至 1m，记录不包含 SQL 参数。
MENDRY_POSTGRES_SLOW_QUERY_THRESHOLD=500ms
# When explicitly enabled, emitted db.query.completed records include executable SQL that can be pasted directly. Disabled by default and does not change the log level.
# 显式打开后，已发出的 db.query.completed 记录会带一条可直接粘贴执行的 SQL；默认关闭，不改变日志级别。
MENDRY_POSTGRES_QUERY_DEBUG=false
# Maximum time the migration command waits for the PostgreSQL advisory lock; accepted range is 1s to 10m. Not used by the API server.
# migration 命令等待 PostgreSQL advisory lock 的最长时间；允许 1s 至 10m，不用于 API 服务器。
MENDRY_POSTGRES_MIGRATION_LOCK_TIMEOUT=30s

# Redis

# Redis session-store URL required by the API. Only redis/rediss schemes, host, and credentials are allowed. The database is selected by MENDRY_REDIS_DB; query and fragment are not allowed.
# API 必填的 Redis Session 存储 URL；仅允许 redis/rediss scheme、主机和凭据，数据库由 MENDRY_REDIS_DB 指定，不允许查询或片段。
MENDRY_REDIS_URL=redis://127.0.0.1:6379
# Maximum time to establish a Redis connection; accepted range is 100ms to 1m.
# 建立 Redis 连接的最长时间；允许 100ms 至 1m。
MENDRY_REDIS_DIAL_TIMEOUT=5s
# Socket timeout for a single Redis read; accepted range is 100ms to 1m.
# 单次 Redis 读取的 socket timeout；允许 100ms 至 1m。
MENDRY_REDIS_READ_TIMEOUT=3s
# Socket timeout for a single Redis write; accepted range is 100ms to 1m.
# 单次 Redis 写入的 socket timeout；允许 100ms 至 1m。
MENDRY_REDIS_WRITE_TIMEOUT=3s
# Maximum time to acquire a connection from the Redis connection pool; accepted range is 100ms to 1m.
# 从 Redis 连接池获取连接的最长等待时间；允许 100ms 至 1m。
MENDRY_REDIS_POOL_TIMEOUT=2s
# Per-attempt timeout for Redis startup and readiness PING; accepted range is 100ms to 30s.
# Redis 启动和就绪 PING 的单次超时；允许 100ms 至 30s。
MENDRY_REDIS_HEALTH_TIMEOUT=2s
# Hard limit for the Redis connection pool; accepted range is 1 to 1000.
# Redis 连接池的硬上限；允许 1 至 1000。
MENDRY_REDIS_POOL_SIZE=10
# Minimum number of idle connections the pool attempts to retain; accepted range is 0 to 1000 and must not exceed the pool size.
# 连接池尝试保持的最少空闲连接数；允许 0 至 1000，且不得大于连接池大小。
MENDRY_REDIS_MIN_IDLE_CONNS=1
# Maximum number of retries after a Redis command failure; accepted range is 0 to 5, where 0 disables retries.
# Redis 命令失败后的最大重试次数；允许 0 至 5，0 表示不重试。
MENDRY_REDIS_MAX_RETRIES=2
# Minimum Redis retry backoff; accepted range is 1ms to 1s and must not exceed the maximum backoff.
# Redis 重试退避的最短时间；允许 1ms 至 1s，且不得大于最大退避时间。
MENDRY_REDIS_MIN_RETRY_BACKOFF=10ms
# Maximum Redis retry backoff; accepted range is 1ms to 5s.
# Redis 重试退避的最长时间；允许 1ms 至 5s。
MENDRY_REDIS_MAX_RETRY_BACKOFF=500ms
# Maximum time a Redis connection may remain idle in the pool; accepted range is 30s to 1h.
# Redis 连接在连接池中保持空闲的最长时间；允许 30s 至 1h。
MENDRY_REDIS_MAX_CONN_IDLE_TIME=5m
# Maximum lifetime of a reusable Redis connection; accepted range is 1m to 24h.
# 单个 Redis 连接可被复用的最长生命周期；允许 1m 至 24h。
MENDRY_REDIS_MAX_CONN_LIFETIME=30m
# Redis logical database number; accepted range is 0 to 255. The URL must not declare a database again.
# Redis 逻辑数据库编号；允许 0 至 255，URL 中不得重复声明数据库。
MENDRY_REDIS_DB=0
# Redis commands at or above this duration are logged as slow commands; accepted range is 1ms to 1m. Keys, values, and arguments are not logged.
# Redis 命令达到该耗时后记录为慢命令；允许 1ms 至 1m，记录不包含 key、value 或参数。
MENDRY_REDIS_SLOW_COMMAND_THRESHOLD=250ms

# Integration tests (commented out by default; enable explicitly only when running integration tests)
# 集成测试（默认注释，仅在运行集成测试时显式启用）

# Single-line PostgreSQL connection string for integration tests. The database name must contain a distinct test marker; never reuse a development or production database.
# PostgreSQL 集成测试的单行连接串；数据库名必须含独立的 test 标记，不得复用开发或生产数据库。
# MENDRY_TEST_POSTGRES_URL=postgres://mendry_test:replace-me@127.0.0.1:5432/mendry_test?sslmode=disable
# Isolation confirmation for destructive PostgreSQL tests; it must exactly match the database name in the URL.
# PostgreSQL 破坏性测试的隔离确认值；必须与 URL 中的数据库名完全一致。
# MENDRY_TEST_POSTGRES_ISOLATION=mendry_test

# Single-line redis/rediss URL for Redis integration tests. Tests delete only randomly generated keys created by the current run with the configured prefix.
# Redis 集成测试的单行 redis/rediss URL；测试只删除本次创建且带指定前缀的随机 key。
# MENDRY_TEST_REDIS_URL=redis://:replace-me@127.0.0.1:6379
# Redis test key prefix; maximum 128 characters. It must contain a distinct test marker and end with a colon; never reuse a development or production namespace.
# Redis 测试 key 前缀；最长 128 字符，必须含独立的 test 标记并以冒号结尾，不得复用开发或生产命名空间。
# MENDRY_TEST_REDIS_PREFIX=mendry:test:
