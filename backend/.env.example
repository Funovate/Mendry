# 运行环境标识；允许 development、test、staging 或 production。
FIXTHE_ENVIRONMENT=development
# 结构化日志的最低级别；允许 debug、info、warn 或 error。
FIXTHE_LOG_LEVEL=info
# 进程收到退出信号后，各关闭阶段使用的时间上限；允许 1s 至 2m。
FIXTHE_SHUTDOWN_TIMEOUT=15s

# HTTP

# API server 的监听地址，格式为 host:port；默认只监听本机回环地址。
FIXTHE_HTTP_ADDR=127.0.0.1:8080
# 读取 HTTP request header 的最长时间；允许 100ms 至 1m。
FIXTHE_HTTP_READ_HEADER_TIMEOUT=5s
# 读取完整 HTTP request 的最长时间；允许 100ms 至 5m。
FIXTHE_HTTP_READ_TIMEOUT=15s
# 写出 HTTP response 的最长时间；允许 100ms 至 5m。
FIXTHE_HTTP_WRITE_TIMEOUT=30s
# keep-alive connection 等待下一个 request 的最长空闲时间；允许 1s 至 10m。
FIXTHE_HTTP_IDLE_TIMEOUT=60s
# 单个 HTTP request body 的字节上限；允许 1024 至 10485760（10 MiB）。
FIXTHE_HTTP_MAX_BODY_BYTES=1048576
# 浏览器跨源访问允许的唯一 origin；同源部署留空，非空值必须是无 credential、path、query 和 fragment 的 http/https origin。
FIXTHE_HTTP_CORS_ALLOWED_ORIGIN=

# PostgreSQL

# API 和 migration 命令必填的单行 pgx 连接串；可能包含 credential，不得提交真实值或写入日志。
FIXTHE_POSTGRES_URL=postgres://fixthe:replace-me@127.0.0.1:5432/fixthe?sslmode=disable
# 建立 PostgreSQL connection 的最长时间；允许 100ms 至 1m。
FIXTHE_POSTGRES_CONNECT_TIMEOUT=5s
# 从 pgxpool 获取 connection 的最长等待时间；允许 100ms 至 1m。
FIXTHE_POSTGRES_ACQUIRE_TIMEOUT=2s
# 每条 PostgreSQL statement 的执行时间上限；允许 100ms 至 10m。
FIXTHE_POSTGRES_STATEMENT_TIMEOUT=30s
# PostgreSQL startup 和 readiness probe 的单次超时；允许 100ms 至 30s。
FIXTHE_POSTGRES_HEALTH_TIMEOUT=2s
# pgxpool 保持的最少 connection 数；允许 0 至 100，且不得大于最大连接数。
FIXTHE_POSTGRES_MIN_CONNS=1
# pgxpool 允许的最多 connection 数；允许 1 至 100。
FIXTHE_POSTGRES_MAX_CONNS=10
# 单个 PostgreSQL connection 可被复用的最长生命周期；允许 1m 至 24h。
FIXTHE_POSTGRES_MAX_CONN_LIFETIME=30m
# PostgreSQL connection 在 pool 中保持空闲的最长时间；允许 30s 至 1h。
FIXTHE_POSTGRES_MAX_CONN_IDLE_TIME=5m
# pgxpool 主动检查 idle connection 健康状态的周期；允许 1s 至 10m。
FIXTHE_POSTGRES_HEALTH_CHECK_PERIOD=30s
# PostgreSQL query 达到该耗时后记录为 slow query；允许 10ms 至 1m，记录不包含 SQL 参数。
FIXTHE_POSTGRES_SLOW_QUERY_THRESHOLD=500ms
# migration 命令等待 PostgreSQL advisory lock 的最长时间；允许 1s 至 10m，不用于 API server。
FIXTHE_POSTGRES_MIGRATION_LOCK_TIMEOUT=30s

# Redis

# API 必填的 Redis session store URL；仅允许 redis/rediss scheme、host 和 credential，DB 由 FIXTHE_REDIS_DB 指定，不允许 query 或 fragment。
FIXTHE_REDIS_URL=redis://127.0.0.1:6379
# 建立 Redis connection 的最长时间；允许 100ms 至 1m。
FIXTHE_REDIS_DIAL_TIMEOUT=5s
# 单次 Redis read 的 socket timeout；允许 100ms 至 1m。
FIXTHE_REDIS_READ_TIMEOUT=3s
# 单次 Redis write 的 socket timeout；允许 100ms 至 1m。
FIXTHE_REDIS_WRITE_TIMEOUT=3s
# 从 Redis connection pool 获取 connection 的最长等待时间；允许 100ms 至 1m。
FIXTHE_REDIS_POOL_TIMEOUT=2s
# Redis startup 和 readiness PING 的单次超时；允许 100ms 至 30s。
FIXTHE_REDIS_HEALTH_TIMEOUT=2s
# Redis connection pool 的硬上限；允许 1 至 1000。
FIXTHE_REDIS_POOL_SIZE=10
# pool 尝试保持的最少 idle connection 数；允许 0 至 1000，且不得大于 pool size。
FIXTHE_REDIS_MIN_IDLE_CONNS=1
# Redis command 在失败后的最大重试次数；允许 0 至 5，0 表示不重试。
FIXTHE_REDIS_MAX_RETRIES=2
# Redis retry 退避的最短时间；允许 1ms 至 1s，且不得大于最大退避时间。
FIXTHE_REDIS_MIN_RETRY_BACKOFF=10ms
# Redis retry 退避的最长时间；允许 1ms 至 5s。
FIXTHE_REDIS_MAX_RETRY_BACKOFF=500ms
# Redis connection 在 pool 中保持空闲的最长时间；允许 30s 至 1h。
FIXTHE_REDIS_MAX_CONN_IDLE_TIME=5m
# 单个 Redis connection 可被复用的最长生命周期；允许 1m 至 24h。
FIXTHE_REDIS_MAX_CONN_LIFETIME=30m
# Redis logical database 编号；允许 0 至 255，URL 中不得重复声明 DB。
FIXTHE_REDIS_DB=0
# Redis command 达到该耗时后记录为 slow command；允许 1ms 至 1m，记录不包含 key、value 或参数。
FIXTHE_REDIS_SLOW_COMMAND_THRESHOLD=250ms

# Integration test（默认注释，只有运行 integration test 时才需显式启用）

# PostgreSQL integration test 的单行连接串；database name 必须含独立的 test 标记，不得复用开发或生产数据库。
# FIXTHE_TEST_POSTGRES_URL=postgres://fixthe_test:replace-me@127.0.0.1:5432/fixthe_test?sslmode=disable
# PostgreSQL 破坏性测试的隔离确认值；必须与 URL 中的 database name 完全一致。
# FIXTHE_TEST_POSTGRES_ISOLATION=fixthe_test

# Redis integration test 的单行 redis/rediss URL；测试只删除本次创建且带指定 prefix 的随机 key。
# FIXTHE_TEST_REDIS_URL=redis://:replace-me@127.0.0.1:6379
# Redis 测试 key prefix；最长 128 字符，必须含独立的 test 标记并以冒号结尾，不得复用开发或生产 namespace。
# FIXTHE_TEST_REDIS_PREFIX=fixthe:test:
